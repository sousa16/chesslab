generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String            @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  dailyReminder  Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  accounts       Account[]
  repertoires    Repertoire[]
  sessions       Session[]
  dailyActivity  DailyActivity[]
  puzzleReviews  PuzzleReview[]
  puzzlePrefs    UserPuzzlePrefs?
  motifRatings   UserMotifRating[]
  drillSessions  DrillSession[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Position {
  id                String            @id @default(cuid())
  fen               String            @unique
  // Fullmove counter parsed from the FEN. Stored as a column so the
  // training filters (`exclude first-move positions`) can use a btree
  // index instead of a `LIKE '% 1'` predicate that forced a seq scan.
  fullmoveNumber    Int
  createdAt         DateTime          @default(now())
  repertoireEntries RepertoireEntry[]

  @@index([fullmoveNumber])
}

model Repertoire {
  id        String            @id @default(cuid())
  userId    String
  color     PieceColor
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  openings  Opening[]
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   RepertoireEntry[]

  @@unique([userId, color])
  @@index([userId])
}

model Opening {
  id           String            @id @default(cuid())
  repertoireId String
  name         String            @default("Opening Line")
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  repertoire   Repertoire        @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  entries      RepertoireEntry[]

  @@index([repertoireId])
}

model RepertoireEntry {
  id                String     @id @default(cuid())
  repertoireId      String
  positionId        String
  expectedMove      String
  interval          Int        @default(0)
  easeFactor        Float      @default(2.5)
  repetitions       Int        @default(0)
  nextReviewDate    DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastReviewDate    DateTime?
  learningStepIndex Int        @default(0)
  phase             String     @default("learning")
  // Denormalized: true when no other entry in the same repertoire is a
  // direct child of this one. Maintained by recomputeRepertoireLeaves on
  // every save / delete so the home dashboard can count "lines" with a
  // simple SQL filter instead of replaying the move tree in chess.js on
  // every read. Default true because a freshly-inserted entry has no
  // children yet — recompute will flip it if a later insertion makes it
  // an interior node.
  isLeaf            Boolean    @default(true)
  openingId         String?
  opening           Opening?   @relation(fields: [openingId], references: [id])
  position          Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  repertoire        Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  @@unique([repertoireId, positionId, expectedMove])
  @@index([repertoireId])
  @@index([openingId])
  @@index([positionId])
  @@index([nextReviewDate])
  @@index([repertoireId, nextReviewDate])
  // Hot path for the home dashboard: count leaves per repertoire +
  // phase. Composite ordering lets `WHERE repertoireId = ? AND isLeaf =
  // true` use a single index range.
  @@index([repertoireId, isLeaf, phase])
}

model DailyActivity {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @db.Date
  correctCount      Int      @default(0)
  incorrectCount    Int      @default(0)
  timeSpentMs       Int      @default(0)
  positionsReviewed Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model Puzzle {
  id         String         @id @default(cuid())
  lichessId  String         @unique
  fen        String
  moves      String
  rating     Int
  popularity Int            @default(0)
  themes     String[]
  categories String[]
  createdAt  DateTime       @default(now())
  reviews    PuzzleReview[]

  @@index([rating])
  @@index([categories(ops: ArrayOps)], type: Gin)
  @@index([themes(ops: ArrayOps)], type: Gin)
}

model PuzzleReview {
  id                String    @id @default(cuid())
  userId            String
  puzzleId          String
  interval          Int       @default(0)
  easeFactor        Float     @default(2.5)
  repetitions       Int       @default(0)
  nextReviewDate    DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastReviewDate    DateTime?
  learningStepIndex Int       @default(0)
  phase             String    @default("learning")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle            Puzzle    @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleId])
  @@index([userId])
  @@index([puzzleId])
  @@index([nextReviewDate])
  @@index([userId, nextReviewDate])
}

model UserPuzzlePrefs {
  id String @id @default(cuid())

  userId String @unique
  // Adaptive controller setpoint — replaces the old static ratingMin/ratingMax band.
  // Used as the puzzle-rating target when no specific motif is being trained
  // (mixed mode, or a motif with no UserMotifRating yet). Updated after each
  // attempt by the EWMA controller in src/lib/adaptiveRating.ts.
  currentTargetRating Int @default(1200)
  // Global EWMA controller state — updated on every attempt regardless of
  // mode. Per-motif state lives in UserMotifRating; these three are the
  // "overall how am I doing" counters that drive currentTargetRating.
  globalEwmaSuccess Float @default(0.5)
  globalAttempts    Int   @default(0)
  globalCorrect     Int   @default(0)
  // Selection mode:
  //   "auto"    = blocked-then-interleaved; the server picks a locked motif
  //               to drill until it unlocks, then mixes
  //   "blocked" = force one motif (blockedFilterMotif). Used by the
  //               adaptive flow internally and by the user when manually
  //               drilling a weakness.
  //   "mixed"   = ignore motif gating, sample across the whole catalog
  mode               String  @default("auto")
  blockedFilterMotif String?

  enabledCategories String[] @default(["Mates", "Motifs", "Middlegame", "Endgame"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Per-user, per-motif adaptive state. Lazily created on first attempt of a
// motif (see src/app/api/puzzles/review/route.ts). One row per major motif
// listed in src/lib/motifs.ts; minor themes are not tracked here.
model UserMotifRating {
  id     String @id @default(cuid())
  userId String
  motif  String

  // Target puzzle rating for this motif. Controller bumps ±25 when the
  // EWMA leaves the [0.80, 0.90] window.
  rating Int @default(1200)
  // Exponentially-weighted success rate. EWMA ← (1-α)·EWMA + α·hit, α≈0.15.
  // Decay half-life is ~5 attempts; "recent form" rather than lifetime accuracy.
  ewmaSuccess Float @default(0.5)
  attempts    Int   @default(0)
  correct     Int   @default(0)

  // Sticky: once a user has ≥20 attempts AND EWMA ≥ 0.80 at this motif, it's
  // unlocked into the mixed pool. Stays unlocked even after a bad streak so
  // we don't oscillate the user back into blocked mode.
  unlocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, motif])
  @@index([userId])
  @@index([userId, unlocked])
}

// A Woodpecker-style drill: a fixed set of puzzles repeated across cycles
// until automatic, then handed to the SRS with a long first interval.
model DrillSession {
  id     String @id @default(cuid())
  userId String

  // Canonical motif name from src/lib/motifs.ts, or "mixed" for cross-motif
  // sets. The puzzle set is frozen at creation time.
  motif        String
  size         Int
  puzzleIds    String[]
  cycle        Int @default(1)
  targetCycles Int @default(5)
  // Position within the current cycle's permutation, 0-indexed.
  position     Int @default(0)
  // Wall time for cycle 1 (the baseline) — drill UX shows ratio vs. this.
  baselineMs   Int?
  // Last completed cycle's wall time, for the in-progress comparison chip.
  lastCycleMs  Int?

  // active | completed | abandoned. "completed" sets completedAt and seeds
  // PuzzleReview rows in the exponential phase at ~14d interval.
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts DrillAttempt[]

  @@index([userId, status])
}

model DrillAttempt {
  id        String   @id @default(cuid())
  sessionId String
  puzzleId  String
  cycle     Int
  correct   Boolean
  timeMs    Int
  attemptedAt DateTime @default(now())

  session DrillSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, cycle])
}

enum PieceColor {
  White
  Black
}
